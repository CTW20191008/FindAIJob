# 复制为 .env 后填写（勿提交）

# 公网必填：与服务端 FINDAIJOB_API_SECRET 一致的密钥；前端仅在浏览器本地演示时可留空
# VITE_ 前缀若在纯静态前端需要可后续添加；当前 Web 同源调用 API，用下方服务端配置即可

FINDAIJOB_API_SECRET=

# ---------- LLM（OpenAI 兼容：官方 OpenAI、Azure、阿里云 DashScope 兼容模式等）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=qwen-max
OPENAI_EMBEDDING_MODEL=text-embedding-v2

# 索引使用的嵌入模型必须与建库时一致；换模型请删除 data/chroma 后重新 ingest

# ---------- 可选：服务端覆盖 ----------
# FINDAIJOB_KNOWLEDGE_ROOT=.  （默认仓库根）
